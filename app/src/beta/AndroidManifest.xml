<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Лише тестова збірка (flavor beta): сервіс бачить ТІЛЬКИ назву пакета застосунку, що вийшов на передній план
             (canRetrieveWindowContent = false), і показує екран паузи перед обраними застосунками. -->
        <service
            android:name=".gates.GateAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gate_accessibility_service" />
        </service>

        <!-- Етап 8: лист плану поверх стрічки — прозора activity у власній задачі, не з'являється в «Недавніх». -->
        <activity
            android:name=".gates.PlanOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.Tepera.PlanOverlay"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <!-- v3.0 MVP, Етап 4 (лише beta): нагадування перед годиною ризику. Приймають тільки системні події й власні
             PendingIntent застосунку. -->
        <receiver android:name=".data.NudgeReceiver" android:exported="false" />
        <receiver android:name=".data.NudgeActionReceiver" android:exported="false" />
        <receiver android:name=".data.NudgeBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
