<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Лише тестова збірка (flavor beta): сервіс бачить ТІЛЬКИ назву пакета застосунку, що вийшов на передній план
             (canRetrieveWindowContent = false), і показує екран паузи перед обраними застосунками. -->
        <service
            android:name=".gates.GateAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gate_accessibility_service" />
        </service>
    </application>
</manifest>
