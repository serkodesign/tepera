<resources>
    <string name="a11y_service_label">Tepera: delay before apps</string>
    <string name="a11y_service_description">Notices which app was opened and shows a short pause before the ones you picked in Tepera. Screen content is not read. Data about opened apps stays on the device and is not shared.</string>
    <string name="soft_exit_title">%1$d min have passed</string>
    <string name="soft_exit_body">Time to close %1$s. Your plan: %2$s.</string>
    <string name="soft_exit_more">5 more</string>
    <string name="soft_exit_leave">Leave</string>
    <string name="soft_exit_confirm_title">5 more minutes?</string>
    <string name="soft_exit_confirm_body">The session has lasted %1$d min instead of 5. That is fine — you are just deciding on purpose.</string>
    <string name="soft_exit_confirm_more">Yes, 5 more min</string>
    <string name="soft_exit_toast_on_time">On time · %1$d min of %2$d</string>
    <string name="soft_exit_toast_late">Done · %1$d min of %2$d</string>
