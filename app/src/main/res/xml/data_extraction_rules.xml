<?xml version="1.0" encoding="utf-8"?>
<!-- FR-6.1: cloud backup / device-transfer (API 31+). Усе включається, КРІМ згоди на аналітику
     (shared_prefs/analytics_consent.xml): її не відновлюємо на новому пристрої чи після
     перевстановлення — людина обирає заново. Той самий виняток, що в backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="analytics_consent.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="analytics_consent.xml" />
    </device-transfer>
</data-extraction-rules>
