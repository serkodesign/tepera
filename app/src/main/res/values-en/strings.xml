    <!-- Usage access onboarding (FR-7.1) -->
    <string name="onboarding_screen_title">Your day\'s structure</string>
    <string name="onboarding_explanation">Tepera shows the structure of your day: how much time online, how much you\'ve noted in entries, and how much is left for everything else. The online part needs access to app usage statistics — a system permission that can\'t be granted through a normal dialog, only manually in Settings, so it can show a real number next to your estimate. Logging activities stays fully functional without it.</string>
    <string name="onboarding_skip">Skip</string>
    <string name="perm_title">Before we begin</string>
    <string name="perm_body">Your entries and app usage time stay on your phone. The only thing that leaves it is anonymous crash reports — you can turn them off in Settings</string>
    <string name="perm_usage_label">Usage access</string>
    <string name="perm_continue">Continue</string>
    <string name="target_onboarding_title">A reference for your day</string>
    <string name="target_onboarding_body">A reference is an optional, quiet tick on your day scale. It doesn\'t judge anything and never changes colors. You can set it now or later in Settings.</string>
    <string name="target_onboarding_average_format">Over the last %1$d days, about %2$s online per day on average. It\'s only a starting point — pick your own.</string>
    <string name="target_onboarding_later">Later</string>
    <string name="target_onboarding_set">Set</string>
    <string name="settings_target_off_hint">No reference — nothing is marked on the day scale.</string>
    <string name="welcome_back_title">Here\'s how these days went</string>
    <plurals name="welcome_back_period">
        <item quantity="one">Over %d day</item>
        <item quantity="other">Over %d days</item>
    </plurals>
    <string name="welcome_back_logged_format">Noted: %1$s</string>
    <string name="welcome_back_online_format">Online on average: %1$s per day</string>
    <string name="weekly_summary_label">Weekly summary</string>
    <string name="weekly_summary_hint">Once a week, on Sunday evening — one quiet notification. Tapping it opens your week\'s summary. There are no other notifications.</string>
    <string name="weekly_summary_permission_hint">Without notification permission the summary won\'t arrive. You can allow it in the app\'s system settings — everything else works as before.</string>
    <string name="weekly_summary_channel_name">Weekly summary</string>
    <string name="weekly_summary_notification_text">Your weekly summary is ready.</string>
    <string name="settings_pro_interest_action">Tepera Pro</string>
    <string name="pro_interest_screen_title">Tepera Pro</string>
    <string name="pro_interest_title">Tepera Pro — in development</string>
    <string name="pro_interest_body">We\'re wondering whether Tepera needs a separate extended version. It doesn\'t exist yet — right now this is only a question for you. No prices, no payments. If you\'re curious, tell us what would be useful.</string>
    <string name="pro_interest_action">I want to know more</string>
    <string name="crash_reports_label">Crash reports</string>
    <string name="crash_reports_explanation">During testing, Tepera sends the developer anonymous reports when the app crashes (via Firebase Crashlytics by Google). A report contains the phone model, Android version and a technical description of the crash; it does not contain your entries, categories or app usage time. You can turn this off in Settings at any time.</string>

