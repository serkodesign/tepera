<?xml version="1.0" encoding="utf-8"?>
<!-- Прев'ю віджета «Дві кнопки активностей» (2x1), Android 12+: капсула з двома кнопками без накладання. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="72dp" android:layout_gravity="center"
        android:background="@drawable/widget_preview_pill" android:gravity="center_vertical" android:orientation="horizontal"
        android:padding="8dp">
        <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/widget_preview_button_reading">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/ic_widget2_reading_selected" android:tint="#FF783D83" android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="8dp"
            android:background="@drawable/widget_preview_button">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/ic_widget2_nature" android:tint="@color/widget_glyph_unselected" android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
