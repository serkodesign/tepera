<?xml version="1.0" encoding="utf-8"?>
<!-- Статичне превью інформаційного віджета (online_ring) для меню віджетів на Android < 15. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#A9C9B6" android:endColor="#7DA28F" /><corners android:radius="22dp" /></shape></item>
    <item android:width="100dp" android:height="50dp" android:gravity="center"><shape android:shape="rectangle"><solid android:color="#E0FFFFFF" /><corners android:radius="100dp" /></shape></item>
    <item android:width="32dp" android:height="32dp" android:gravity="center_vertical|start" android:start="30dp"><shape android:shape="ring" android:innerRadiusRatio="2.6" android:thicknessRatio="7" android:useLevel="false"><solid android:color="#FFF5C401" /></shape></item>
    <item android:width="30dp" android:height="8dp" android:gravity="center_vertical|start" android:start="70dp" android:top="0dp"><shape android:shape="rectangle"><solid android:color="#FF003926" /><corners android:radius="4dp" /></shape></item>
</layer-list>
