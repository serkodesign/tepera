    <item><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#A9C9B6" android:endColor="#7DA28F" /><corners android:radius="22dp" /></shape></item>
    <item android:width="150dp" android:height="50dp" android:gravity="center"><shape android:shape="rectangle"><solid android:color="#E0FFFFFF" /><corners android:radius="100dp" /></shape></item>
    <item android:width="70dp" android:height="6dp" android:gravity="center_vertical|start" android:start="22dp" android:top="-12dp"><shape android:shape="rectangle"><solid android:color="#FF4D6B60" /><corners android:radius="4dp" /></shape></item>
    <item android:width="40dp" android:height="14dp" android:gravity="center_vertical|start" android:start="22dp" android:top="10dp"><shape android:shape="rectangle"><solid android:color="#FFDCF6ED" /><corners android:radius="4dp" /></shape></item>
    <item android:width="40dp" android:height="14dp" android:gravity="center_vertical|start" android:start="68dp" android:top="10dp"><shape android:shape="rectangle"><solid android:color="#FFDCF6ED" /><corners android:radius="4dp" /></shape></item>
</layer-list>
