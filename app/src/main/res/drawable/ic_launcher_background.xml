<?xml version="1.0" encoding="utf-8"?>
<!-- Концепт "B. Два хребти" (гора+сонце, дихання/розслаблення/заземлення), обраний користувачем
     із 4 варіантів (артефакт "Гірський світанок"). Небо — вертикальний градієнт, м'який перехід
     від блідо-м'ятного до теплого персикового; це задній шар adaptive-іконки, поверх якого
     ic_launcher_foreground.xml малює хребти й сонце. android:angle="270" — Android GradientDrawable
     рахує кут проти годинникової стрілки від "0 = зліва направо", тож 270° дає "згори вниз"
     (startColor угорі, endColor унизу). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#E9F3EC"
        android:endColor="#FFD6B3" />
</shape>
