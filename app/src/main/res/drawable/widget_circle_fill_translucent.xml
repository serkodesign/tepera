<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma node 9:421/11:647 ("перемалюй віджет") — звичайна НЕактивна кнопка категорії: не
    обвідна лінія (як у попередньому стиль-референсі, widget_circle_outline.xml), а напівпрозоре
    БІЛЕ ЗАПОВНЕННЯ кола ("ефект скла") — буквальна вимога користувача: #FFFFFF @ 0.5 прозорості
    (не 0.3, як у першій версії — виправлено за прямою вказівкою). Крізь напівпрозору білість
    видно кольоровий градієнтний фон Column (widget_gradient_bg.xml). widget_circle_outline_neglected.xml
    (бурштинова обвідна лінія, занедбана категорія) лишається БЕЗ змін — за прямим рішенням
    користувача під час запиту на перемальовку.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#80FFFFFF" />
</shape>
