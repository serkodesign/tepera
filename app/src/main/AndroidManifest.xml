<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- v2.0: Health Connect / Activity Recognition ВИДАЛЕНО — перенесено на post-MVP (SRS 3.1, FR-1.5) -->

    <!-- UsageStatsManager (FR-3.1, FR-7.1) — це protected permission, звичайний runtime-діалог
         не працює. Користувач надає доступ вручну через Налаштування → Спеціальний доступ →
         Доступ до статистики використання (Intent: ACTION_USAGE_ACCESS_SETTINGS).
         tools:ignore потрібен, бо lint попереджає про protected permissions за замовчуванням. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- WorkManager для періодичного оновлення віджета (FR-4.3) не потребує окремого дозволу -->

    <!-- Сповіщення "усе ще цим займаєшся?" через 4 год роботи тап-таймера (Figma user-flow
         k6s4prQ9oK9x2uUvzHRghR, node 14:791, за прямим рішенням користувача — ЛИШЕ сповіщення,
         без автозупинки). Звичайний runtime-дозвіл (Android 13+), не protected/sensitive —
         запитується через системний діалог (HomeScreen), не через окремі Налаштування. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Свідомо ВІДСУТНІ: жодні локаційні дозволи (FR-7.2) -->

    <!-- FR-3.5, спайк Фази 2 (ROADMAP.md): package visibility filtering (Android 11+) справді
         блокує PackageManager.getApplicationInfo() для більшості пакетів, побачених через
         UsageStatsManager, — підтверджено на реальному пристрої (Samsung S23). Замість
         QUERY_ALL_PACKAGES (другий чутливий дозвіл, ризик Google Play review, SRS розділ 10)
         достатньо задекларувати видимість застосунків із launcher-іконкою — це охоплює
         практично всі застосунки, які користувач реально захоче виключити (карти, е-читалки,
         банкінг), і НЕ вважається "чутливим" дозволом при review. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TeperaApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Tepera">

        <!-- launchMode="singleTask" — T-5 (tepera-dev-spec.md): без нього повторний тап по
             закріпленому ярлику воріт (T-4), коли Tepera вже у фоні, лише виносить наявний
             інстанс наперед БЕЗ гарантованого виклику onNewIntent() (стандартний "standard"
             launchMode не дає цієї гарантії для вже запущеної того самого afinity задачі) — нові
             extras (цільовий пакет воріт) губляться, і екран паузи для повторного тапу просто
             не з'являється. singleTask також безпечний для наявних входів (FR-4.1/4.4 — тап по
             віджету/Quick Settings tile). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Jetpack Glance-віджет (FR-4.1) — компактна 4x1 і розширена 4x2 через SizeMode.Responsive -->
        <receiver
            android:name=".widget.TeperaWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/life_balance_widget_info" />
        </receiver>

        <!-- "Так"/"Ні" на сповіщенні "усе ще цим займаєшся?" (TimerCheckWorker) -->
        <receiver
            android:name=".data.TimerCheckNotificationReceiver"
            android:exported="false" />

        <!-- Quick Settings Tile (FR-4.4) -->
        <service
            android:name=".widget.QuickLogTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_add"
            android:label="@string/tile_quick_add"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
