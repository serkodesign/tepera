<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- v2.0: Health Connect / Activity Recognition ВИДАЛЕНО — перенесено на post-MVP (SRS 3.1, FR-1.5) -->

    <!-- UsageStatsManager (FR-3.1, FR-7.1) — це protected permission, звичайний runtime-діалог
         не працює. Користувач надає доступ вручну через Налаштування → Спеціальний доступ →
         Доступ до статистики використання (Intent: ACTION_USAGE_ACCESS_SETTINGS).
         tools:ignore потрібен, бо lint попереджає про protected permissions за замовчуванням. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- WorkManager для періодичного оновлення віджета (FR-4.3) не потребує окремого дозволу -->


    <!-- CC-8: єдине сповіщення застосунку — тижневий підсумок, лише якщо людина сама його ввімкнула в Налаштуваннях.
         Runtime-дозвіл (Android 13+) запитується тільки в момент ввімкнення, не при першому запуску. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Свідомо ВІДСУТНІ: жодні локаційні дозволи (FR-7.2) -->

    <!-- FR-3.5, спайк Фази 2 (ROADMAP.md): package visibility filtering (Android 11+) справді
         блокує PackageManager.getApplicationInfo() для більшості пакетів, побачених через
         UsageStatsManager, — підтверджено на реальному пристрої (Samsung S23). Замість
         QUERY_ALL_PACKAGES (другий чутливий дозвіл, ризик Google Play review, SRS розділ 10)
         достатньо задекларувати видимість застосунків із launcher-іконкою — це охоплює
         практично всі застосунки, які користувач реально захоче виключити (карти, е-читалки,
         банкінг), і НЕ вважається "чутливим" дозволом при review. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TeperaApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Tepera">

        <!-- D-15: Crashlytics нічого не збирає, доки TeperaApp не застосує вибір користувача
             (util/CrashReporting.apply). Без цього SDK стартував би з увімкненим збором до
             того, як людина встигла побачити перемикач. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!-- launchMode="singleTask" — T-5 (tepera-dev-spec.md): без нього повторний тап по
             закріпленому ярлику воріт (T-4), коли Tepera вже у фоні, лише виносить наявний
             інстанс наперед БЕЗ гарантованого виклику onNewIntent() (стандартний "standard"
             launchMode не дає цієї гарантії для вже запущеної того самого afinity задачі) — нові
             extras (цільовий пакет воріт) губляться, і екран паузи для повторного тапу просто
             не з'являється. singleTask також безпечний для наявних входів (FR-4.1/4.4 — тап по
             віджету/Quick Settings tile). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Jetpack Glance-віджет (FR-4.1) — компактна 4x1 і розширена 4x2 через SizeMode.Responsive -->
        <receiver
            android:name=".widget.TeperaWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/life_balance_widget_info" />
        </receiver>

        <!-- Той самий віджет із типовим розміром 4x2 — окремий запис у меню віджетів -->
        <receiver
            android:name=".widget.TeperaWidget4x2Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/life_balance_widget_4x2_info" />
        </receiver>

        <!-- Віджети 1x1 (1 кнопка) і 2x1 (2 кнопки) — обрані в Налаштування → Віджет категорії -->
        <receiver
            android:name=".widget.TeperaWidget1x1Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/life_balance_widget_1x1_info" />
        </receiver>
        <receiver
            android:name=".widget.TeperaWidget2x1Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/life_balance_widget_2x1_info" />
        </receiver>


        <!-- Quick Settings Tile (FR-4.4) -->
        <service
            android:name=".widget.QuickLogTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_add"
            android:label="@string/tile_quick_add"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
